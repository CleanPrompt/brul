### No token (expect 401 UNAUTHORIZED)
GET {{baseUrl}}/api/v1/feedback

> {%
    client.test("Request without token is rejected", function () {
        client.assert(response.status === 401, "Expected 401, got " + response.status);
        client.assert(response.body.code === "UNAUTHORIZED", "Got code " + response.body.code);
    });
%}
