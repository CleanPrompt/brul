HOST=127.0.0.1
PORT=8080

DATABASE_URL=jdbc:h2:file:./data/example
DATABASE_DRIVER=org.h2.Driver
DATABASE_USER=sa
DATABASE_PASSWORD=

JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=example-backend
JWT_AUDIENCE=example-api

# The account that registers with this email gets the ADMIN role. Leave empty to disable.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
